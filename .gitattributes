# Auto detect text files and perform LF normalization on checkin
* text=auto eol=lf

# Source code and scripts (force LF line endings)
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.lock text eol=lf
*.example text eol=lf
*.ini text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary artifacts (never touch line endings)
*.joblib binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary
*.sqlite binary
*.db binary
