# CommShield Environment Configuration Template
# Copy to .env and configure for your deployment environment
# Windows PowerShell: Copy-Item .env.example .env
# Linux/Bash:         cp .env.example .env

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=false
DEMO_MODE=true

# Database Configuration (Relative SQLite path compatible across Windows and Linux)
DATABASE_URL=sqlite:///backend/commshield.db

# Privacy by Design & Cryptographic Salts
# Replace with a high-entropy secret in production (minimum 32 bytes)
COMMSHIELD_HMAC_KEY=replace-with-a-secure-random-hmac-secret-in-production
COMMSHIELD_TWIN_HMAC_KEY=replace-with-a-secure-random-twin-hmac-key-in-production

# Small-Group Suppression Threshold (k-anonymity)
# Suppress entropy-style aggregates for windows with fewer than K distinct UEs
COMMSHIELD_SUPPRESSION_K=5

# Access Control Tokens
# Bearer token required for state-mutating governance actions (approve, reject, rollback)
COMMSHIELD_ANALYST_TOKEN=commshield-analyst-secret-v1

# Frontend API Configuration
VITE_API_URL=http://localhost:8000
